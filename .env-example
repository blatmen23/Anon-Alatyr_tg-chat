# Токен бота Telegram (получить у @BotFather)
TOKEN=your_telegram_bot_token_here

# ID администратора (можно получить у @userinfobot)
ADMIN_1=123456789

# Номер карты Сбербанка для оплаты
SBERBANK=1234567890123456

# Номер карты Тинькофф для оплаты
TINKOFF=1234567890123456

# Ник менеджера по рекламе (без @!)
ADVERTISING_MANAGER=manager_nickname

# ID чата для модерации (группа или канал, куда отправлять посты на проверку)
MODERATION_CHAT_ID=-1001234567890